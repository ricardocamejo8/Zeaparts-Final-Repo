{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/privacidad", "destination": "/politica-privacidad", "permanent": true },
    { "source": "/envio", "destination": "/politica-envio", "permanent": true },
    { "source": "/carroceria-spark", "destination": "/carroceria?modelo=spark", "permanent": false },
    { "source": "/carroceria-aveo", "destination": "/carroceria?modelo=aveo", "permanent": false },
    { "source": "/carroceria-sail", "destination": "/carroceria?modelo=sail", "permanent": false }
  ]
}
